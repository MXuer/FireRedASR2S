        <mxCell id="e6" edge="1" parent="1" source="evidence" target="fusion" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e7" edge="1" parent="1" source="fusion" target="decision" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e8" edge="1" parent="1" source="fusion" target="fused" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e9" edge="1" parent="1" source="raw_vad" target="output_vad" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e10" edge="1" parent="1" source="fused" target="align" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e11" edge="1" parent="1" source="output_vad" target="align" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;">
