{
  "name": "silero_funasr_fireredpunc",
  "language": "zh_cn",
  "components": {
    "vad": {
      "name": "silero",
      "params": {}
    },
    "asr": {
      "name": "funasr_nano",
      "params": {
        "device": "cuda:0",
        "hub": "ms",
        "batch_size": 8
      }
    },
    "timestamp": {
      "name": "funasr_native",
      "params": {}
    },
    "punc": {
      "name": "firered_punc",
      "params": {
        "model_dir": "pretrained_models/FireRedPunc",
        "config": {
          "use_gpu": true
        }
      }
    }
  },
  "pipeline": {
    "asr_batch_size": 8,
    "punc_batch_size": 8,
    "sentence_boundary_fusion": {
      "enabled": true,
      "min_vad_silence_s": 0.2,
      "max_vad_snap_gap_s": 1.0,
      "merge_max_token_gap_s": 0.3,
      "acoustic_window_s": 0.05,
      "acoustic_context_s": 0.3,
      "acoustic_valley_ratio": 0.25,
      "target_sentence_s": 15.0,
      "max_sentence_s": 30.0
    }
  },
  "output": {
    "outdir": "output/experiments/silero_funasr_fireredpunc",
    "write_textgrid": true,
    "write_srt": true,
    "write_csv": true,
    "copy_resolved_config": true
  }
}
