{
  "name": "fireredvad_whisper_qwenaligner_textpunc_ko",
  "language": "ko_kr",
  "components": {
    "vad": {
      "name": "firered_vad",
      "params": {
        "model_dir": "pretrained_models/FireRedVAD/VAD",
        "config": {
          "use_gpu": true
        }
      }
    },
    "asr": {
      "name": "whisper_large",
      "params": {
        "model_name": "large-v3",
        "device": "cuda:0",
        "word_timestamps": false
      }
    },
    "timestamp": {
      "name": "qwen3_forced_aligner",
      "params": {
        "model": "Qwen/Qwen3-ForcedAligner-0.6B",
        "device_map": "cuda:0",
        "batch_size": 4
      }
    },
    "punc": {
      "name": "asr_text",
      "params": {}
    }
  },
  "pipeline": {
    "asr_batch_size": 1,
    "punc_batch_size": 1,
    "strip_punctuation_before_punc": false,
    "sentence_boundary_fusion": {
      "enabled": true,
      "min_vad_silence_s": 0.2,
      "max_vad_snap_gap_s": 1.0,
      "merge_max_token_gap_s": 0.3,
      "acoustic_window_s": 0.05,
      "acoustic_context_s": 0.3,
      "acoustic_valley_ratio": 0.25,
      "target_sentence_s": 15.0,
      "max_sentence_s": 30.0
    }
  },
  "output": {
    "outdir": "output/experiments/fireredvad_whisper_qwenaligner_textpunc_ko",
    "write_textgrid": true,
    "write_srt": true,
    "write_csv": true,
    "copy_resolved_config": true
  }
}
