{
  "name": "ko_kr",
  "language": "ko_kr",
  "components": {
    "vad": {
      "name": "firered_vad",
      "params": {
        "model_dir": "pretrained_models/FireRedVAD/VAD",
        "config": {
          "use_gpu": true
        }
      }
    },
    "asr": {
      "name": "qwen3_asr_1_7b"
    },
    "timestamp": {
      "name": "qwen3_forced_aligner",
      "params": {
        "model": "Qwen/Qwen3-ForcedAligner-0.6B",
        "device_map": "cuda:0",
        "batch_size": 4
      }
    },
    "punc": {
      "name": "xlm_roberta_punctuation"
    }
  },
  "pipeline": {
    "asr_batch_size": 1,
    "punc_batch_size": 1,
    "strip_punctuation_before_punc": false
  },
  "output": {
    "outdir": "output/experiments/multilingual_5min/ko_kr",
    "write_textgrid": true,
    "write_srt": true,
    "write_csv": true,
    "copy_resolved_config": true
  }
}
