{
  "name": "th_th_whisper_th",
  "language": "th_th",
  "components": {
    "vad": {
      "name": "firered_vad",
      "params": {
        "use_gpu": true
      }
    },
    "asr": {
      "name": "whisper_th_large_v3_combined",
      "params": {
        "batch_size": 64
      }
    },
    "timestamp": {
      "name": "mms_forced_aligner"
    },
    "punc": {
      "name": "wtpsplit_boundary",
      "params": {
        "base_url": "http://127.0.0.1:11001",
        "max_length": 35,
        "min_span_s": 2.0
      }
    }
  },
  "pipeline": {
    "strip_punctuation_before_punc": false
  },
  "output": {
    "outdir": "output/experiments/th_th_whisper_th"
  }
}
